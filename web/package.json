{
  "name": "homelab-proxy-manager-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@lucide/vue": "1.80.0",
    "@tanstack/vue-query": "5.108.4",
    "@vee-validate/zod": "4.15.1",
    "@vueuse/core": "15.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.1",
    "vee-validate": "4.15.1",
    "vue": "3.5.46",
    "vue-router": "5.5.1",
    "zod": "3.25.76"
  }
}
