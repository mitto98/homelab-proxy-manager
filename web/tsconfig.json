{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "vite/client"],
    "noEmit": true,
    "strict": true
  },
  "include": ["src/**/*", "src/**/*.vue", "e2e/**/*", "*.ts"]
}
